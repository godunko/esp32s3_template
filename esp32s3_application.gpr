
with "runtime/build_libgnat.gpr";
with "runtime/build_libgnarl.gpr";

with "config/esp32s3_application_config.gpr";

project ESP32S3_Application is

   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use "runtime";

   for Source_Dirs use ("source");
   for Object_Dir use ".objs";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "app_main.o";
   end Builder;

   package Binder is
      for Switches ("Ada") use
        ("-D4k",
         --  Default secondary stack size = nn [kilo|mega] bytes
         --
         --  Secondary stacks are statically allocated, so their size is
         --  fixed by this switch and cannot grow at run time.
         "-Q3",
         --  Generate nnn additional default-sized secondary stacks
         --
         --  ESP32-S3 requires at least three: one for the environment task
         --  and one for interrupt handlers on each CPU.
         --  Add one stack per foreign thread using a secondary stack over
         --  the application lifetime. Ordinary Ada tasks are counted by
         --  the binder separately.
         "-Mapp_main");
         --  Set the binder generated main function's name to app_main as this
         --  is required by the SDK.
   end Binder;

   package Compiler is
      for Switches ("Ada") use ("-g", "-O2");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;

end ESP32S3_Application;
